{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm site:build",
    "clean": "pnpm site:clean",
    "start": "pnpm sync-submodules && pnpm lib:build && pnpm lib:dev & pnpm astro:dev",
    "dev": "pnpm lib:dev & pnpm astro:dev",
    "lib:dev": "pnpm --filter @chassis-ui/react dev",
    "preview": "pnpm astro:preview",
    "site": "pnpm site:build && pnpm site:lint",
    "site:build": "pnpm api:generate && pnpm sync-submodules && pnpm astro:build && pnpm site:pagefind",
    "site:pagefind": "pagefind --site _site --output-subdir react/pagefind",
    "site:clean": "rm -rf _site packages/site/node_modules packages/site/.astro packages/site/public",
    "astro:dev": "pnpm --filter chassis-react-site dev --port 4327 --host",
    "astro:build": "pnpm --filter chassis-react-site build",
    "astro:preview": "pnpm --filter chassis-react-site preview",
    "api:generate": "ts-node --project build/tsconfig.json build/generate-api.ts",
    "api:report": "ts-node --project build/tsconfig.json build/check-api-surface.ts",
    "api:report:update": "ts-node --project build/tsconfig.json build/check-api-surface.ts --update",
    "lib:build": "pnpm --filter @chassis-ui/react build",
    "generate": "pnpm --filter @chassis-ui/react generate",
    "generate:sub": "pnpm --filter @chassis-ui/react generate:sub",
    "lint": "eslint \"packages/**/src/**/*.{js,ts,tsx}\"",
    "format": "prettier --write \"packages/site/src/examples/**/*.tsx\"",
    "format:check": "prettier --check \"packages/site/src/examples/**/*.tsx\"",
    "react:lint": "pnpm react:lint:eslint && pnpm react:lint:stylelint && pnpm react:lint:prettier",
    "react:lint:eslint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives packages/react",
    "react:lint:stylelint": "stylelint --cache --cache-location .cache/.stylelintcache packages/react/\"**/*.{css,scss}\"",
    "react:lint:prettier": "prettier -c --cache packages/react",
    "site:lint": "pnpm site:lint:eslint && pnpm site:lint:stylelint && pnpm site:lint:prettier && pnpm site:lint:vnu",
    "site:lint:eslint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives packages/site",
    "site:lint:stylelint": "stylelint --cache --cache-location .cache/.stylelintcache packages/site/\"**/*.{css,scss}\"",
    "site:lint:prettier": "prettier -c --cache packages/site",
    "site:lint:html": "node build/html-validate.js",
    "site:lint:vnu": "node build/vnu-jar.js",
    "test": "pnpm --filter @chassis-ui/react test",
    "test:update": "pnpm --filter @chassis-ui/react test:update",
    "test:visual": "pnpm --filter @chassis-ui/react test:visual",
    "test:visual:update": "pnpm --filter @chassis-ui/react test:visual:update",
    "check:astro": "pnpm --filter chassis-react-site astro check",
    "check:bundle": "pnpm --filter @chassis-ui/react check:bundle",
    "check:package": "pnpm --filter @chassis-ui/react check:package",
    "changeset": "changeset",
    "changeset:version": "changeset version && node build/sync-version-refs.js",
    "changeset:publish": "pnpm lib:build && changeset publish",
    "sync-submodules": "node build/sync-submodules.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.6",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^70.0.0",
    "globals": "^17.7.0",
    "html-validate": "^11.5.5",
    "pagefind": "^1.5.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "react-docgen-typescript": "^2.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vnu-jar": "^26.7.3"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
