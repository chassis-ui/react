---
import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
---

<section class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content">
    <div class="grid mb-3xl md:mb-6xl">
      <header class="section-header col-span-full lg:col-span-10 lg:col-start-2 xl:col-span-8 xl:col-start-3 text-center">
        <h2 class="section-title font-3xl md:font-4xl lg:font-5xl mb-xs md:mb-sm lg:mb-md">
          <span class="font-normal d-block">Built on</span> Modern Standards
        </h2>
        <p class="section-body md:font-lg lg:font-xl m-0">
          Chassis React stands on the libraries the React ecosystem already trusts, so it fits an
          existing stack without a runtime of its own.
        </p>
      </header>
    </div>

    <div class="section-features grid grid-cols-2 md:grid-cols-4 gap-md md:gap-xl">
      <div>
        <FeatureCard>
          <Fragment slot="title">React 19</Fragment>
          <Fragment slot="body">Server Components</Fragment>
        </FeatureCard>
      </div>
      <div>
        <FeatureCard>
          <Fragment slot="title">React Aria</Fragment>
          <Fragment slot="body">Accessible behavior</Fragment>
        </FeatureCard>
      </div>
      <div>
        <FeatureCard>
          <Fragment slot="title">TypeScript</Fragment>
          <Fragment slot="body">Strict, typed props</Fragment>
        </FeatureCard>
      </div>
      <div>
        <FeatureCard>
          <Fragment slot="title">Chassis CSS</Fragment>
          <Fragment slot="body">Token-driven styles</Fragment>
        </FeatureCard>
      </div>
    </div>
  </div>
</section>
