---
import { nav } from '../data/nav'

interface Props {
  currentSlug: string
}

const { currentSlug } = Astro.props
const base = import.meta.env.BASE_URL  // '/react/'
---

<nav class="cxd-sidebar" aria-label="Documentation navigation">
  {nav.map((group) => (
    <div class="cxd-sidebar-group">
      <div class="cxd-sidebar-heading">{group.title}</div>
      <ul class="cxd-sidebar-list">
        {group.items.map((item) => {
          const isActive = currentSlug === item.slug
          return (
            <li class:list={['cxd-sidebar-item', { active: isActive }]}>
              <a
                href={`${base}${item.slug}/`}
                class:list={['cxd-sidebar-link', { 'active': isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          )
        })}
      </ul>
    </div>
  ))}
</nav>

<style>
  .cxd-sidebar {
    padding: 1.5rem 0;
  }

  .cxd-sidebar-group {
    margin-bottom: 1.5rem;
  }

  .cxd-sidebar-heading {
    padding: 0.25rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cxd-secondary-color, #6c757d);
  }

  .cxd-sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cxd-sidebar-link {
    display: block;
    padding: 0.25rem 1rem;
    color: var(--cxd-body-color, #212529);
    text-decoration: none;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .cxd-sidebar-link:hover {
    color: var(--cxd-link-hover-color, #0a58ca);
    background-color: var(--cxd-light, #f8f9fa);
  }

  .cxd-sidebar-link.active {
    color: var(--cxd-primary, #0d6efd);
    font-weight: 600;
    background-color: color-mix(in srgb, var(--cxd-primary, #0d6efd) 10%, transparent);
  }
</style>
