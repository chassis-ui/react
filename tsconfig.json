{
  "compilerOptions": {
    "jsx": "react",
    "outDir": "dist",
    "module": "esnext",
    "target": "es2017",
    "lib": ["es6", "dom", "es2016", "es2017", "es2018.intl", "es2020.intl", "es2021.intl", "es2022.error"],
    "sourceMap": true,
    "allowJs": false,
    "declaration": true,
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true
  },
  "exclude": ["**/node_modules", "**/dist"]
}