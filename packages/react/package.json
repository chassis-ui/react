{
  "name": "@chassis-ui/react",
  "version": "0.3.0",
  "type": "module",
  "description": "Chassis UI Components Library for React.js",
  "keywords": [
    "react",
    "react-component",
    "react component",
    "chassis-ui",
    "chassis react",
    "ui library",
    "ui components",
    "component library",
    "components"
  ],
  "homepage": "https://chassis-ui.com/react/",
  "bugs": {
    "url": "https://github.com/chassis-ui/react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chassis-ui/react.git"
  },
  "license": "MIT",
  "author": "Chassis UI Team",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./accordion": "./dist/accordion.js",
    "./alert": "./dist/alert.js",
    "./autocomplete": "./dist/autocomplete.js",
    "./avatar": "./dist/avatar.js",
    "./badge": "./dist/badge.js",
    "./breadcrumb": "./dist/breadcrumb.js",
    "./button": "./dist/button.js",
    "./button-group": "./dist/button-group.js",
    "./calendar": "./dist/calendar.js",
    "./card": "./dist/card.js",
    "./carousel": "./dist/carousel.js",
    "./checkbox": "./dist/checkbox.js",
    "./chip": "./dist/chip.js",
    "./chip-input": "./dist/chip-input.js",
    "./close-button": "./dist/close-button.js",
    "./collapse": "./dist/collapse.js",
    "./color-input": "./dist/color-input.js",
    "./combobox": "./dist/combobox.js",
    "./context-menu": "./dist/context-menu.js",
    "./datagrid": "./dist/datagrid.js",
    "./datepicker": "./dist/datepicker.js",
    "./divider": "./dist/divider.js",
    "./drawer": "./dist/drawer.js",
    "./file-input": "./dist/file-input.js",
    "./flex": "./dist/flex.js",
    "./floating-input": "./dist/floating-input.js",
    "./form": "./dist/form.js",
    "./form-field": "./dist/form-field.js",
    "./grid": "./dist/grid.js",
    "./icon": "./dist/icon.js",
    "./input-adorn": "./dist/input-adorn.js",
    "./input-group": "./dist/input-group.js",
    "./link": "./dist/link.js",
    "./list": "./dist/list.js",
    "./menu": "./dist/menu.js",
    "./modal": "./dist/modal.js",
    "./nav": "./dist/nav.js",
    "./nav-overflow": "./dist/nav-overflow.js",
    "./navbar": "./dist/navbar.js",
    "./notification": "./dist/notification.js",
    "./number-field": "./dist/number-field.js",
    "./otp-input": "./dist/otp-input.js",
    "./pagination": "./dist/pagination.js",
    "./password-strength": "./dist/password-strength.js",
    "./placeholder": "./dist/placeholder.js",
    "./popover": "./dist/popover.js",
    "./portal": "./dist/portal.js",
    "./progress": "./dist/progress.js",
    "./radio": "./dist/radio.js",
    "./range-input": "./dist/range-input.js",
    "./scrollspy": "./dist/scrollspy.js",
    "./search-field": "./dist/search-field.js",
    "./select": "./dist/select.js",
    "./skeleton": "./dist/skeleton.js",
    "./spinner": "./dist/spinner.js",
    "./stack": "./dist/stack.js",
    "./static-table": "./dist/static-table.js",
    "./stepper": "./dist/stepper.js",
    "./switch": "./dist/switch.js",
    "./table": "./dist/table.js",
    "./tabs": "./dist/tabs.js",
    "./text-input": "./dist/text-input.js",
    "./textarea": "./dist/textarea.js",
    "./time-field": "./dist/time-field.js",
    "./toast": "./dist/toast.js",
    "./tooltip": "./dist/tooltip.js",
    "./tree": "./dist/tree.js",
    "./visually-hidden": "./dist/visually-hidden.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "./dist/*.js",
    "./dist/chunks/focus-ring-*.js",
    "./dist/style.css"
  ],
  "browserslist": [
    "chrome >= 107",
    "edge >= 107",
    "firefox >= 104",
    "safari >= 16"
  ],
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run --coverage",
    "test:update": "vitest run --coverage -u",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:prettier",
    "lint:eslint": "eslint --cache --cache-location ../../.cache/react.eslintcache --report-unused-disable-directives .",
    "lint:stylelint": "stylelint --cache --cache-location ../../.cache/react.stylelintcache \"**/*.{css,scss}\"",
    "lint:prettier": "prettier -c --cache --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "check:bundle": "bundlewatch --config .bundlewatch.config.json",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:rsc": "ts-node --project ../../build/tsconfig.json ./scripts/check-rsc-directive.ts",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./style.css",
    "check:api": "ts-node --project ../../build/tsconfig.json ./scripts/check-api-surface.ts",
    "check:api:update": "ts-node --project ../../build/tsconfig.json ./scripts/check-api-surface.ts --update",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o ../../_storybook",
    "test:visual": "pnpm storybook:build --quiet && playwright test",
    "test:visual:update": "pnpm storybook:build --quiet && playwright test --update-snapshots",
    "test:visual:update:linux": "bash scripts/update-linux-snapshots.sh"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "classnames": "^2.3.1",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.20.0",
    "react-stately": "^3.50.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@arethetypeswrong/core": "^0.18.5",
    "@chassis-ui/css": "^0.7.0",
    "@chassis-ui/tokens": "^0.7.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tsdown/css": "^0.23.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "bundlewatch": "^0.4.2",
    "http-server": "^14.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-prefix-custom-properties": "^0.1.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "storybook": "^10.6.1",
    "tsdown": "0.23.0",
    "tslib": "^2.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@chassis-ui/css": ">=0.7.0 <0.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
