{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Test File",
      "cwd": "${workspaceFolder}/packages/react",
      "program": "${workspaceFolder}/packages/react/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}"],
      "console": "integratedTerminal",
      "smartStep": true,
      "autoAttachChildProcesses": true
    }
  ]
}

