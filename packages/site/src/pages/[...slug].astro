---
import DocsLayout from '../layouts/DocsLayout.astro'
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import ReactExample from '../components/ReactExample/ReactExample.astro'
import ExampleWrapper from '../components/ReactExample/ExampleWrapper.astro'
import { ExamplePreview } from '../components/ReactExample/ExamplePreview.tsx'
import Callout from '../components/Callout.astro'
import { CalloutReact } from '../components/CalloutReact.tsx'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return docs.map((entry: CollectionEntry<'docs'>) => ({
    params: { slug: entry.id },
    props: entry
  }))
}

const entry = Astro.props as CollectionEntry<'docs'>
const { data } = entry
const { Content, headings } = await render(entry)
---

<DocsLayout frontmatter={data} headings={headings} id={entry.id}>
  <Content components={{ Example: ExampleWrapper, Callout: CalloutReact }} />
</DocsLayout>
