---
// ExampleWrapper.astro — used for MDX component mapping (<Example> → this)
// A plain server-rendered wrapper. Interactive hydration is handled per-page
// by importing ReactExample.astro directly with client:visible.
interface Props {
  className?: string
  class?: string
}
const { className, class: cls } = Astro.props
---
<div class:list={['cxd-example context', className, cls]}>
  <slot />
</div>
