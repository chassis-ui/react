---
import Code from '@chassis-ui/docs/shortcodes/Code.astro'

interface Props {
  class?: string
  id?: string
  /**
   * The source code to display below the live preview.
   * Auto-derived at build time by the `remarkCxExample` remark plugin unless `customMarkup` is set.
   */
  code?: string
  /**
   * Overrides the displayed source code (e.g. to abbreviate large data literals) while the
   * actual children still render live in the preview above.
   */
  customMarkup?: string
  /**
   * Language used to highlight the displayed source.
   * @default 'jsx'
   */
  lang?: string
}

const { class: className, id, code, customMarkup, lang = 'jsx' } = Astro.props
const sourceMarkup = customMarkup ?? code
---

<div class="cxd-example-snippet cxd-code-snippet" data-pagefind-ignore>
  <div id={id} class:list={['cxd-example m-0 border-0 context', className]}>
    <slot />
  </div>
  {sourceMarkup && <Code code={sourceMarkup} lang={lang} nestedInExample hasPreview />}
</div>
