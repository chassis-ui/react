{
  "name": "chassis-react-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Chassis React documentation site",
  "homepage": "https://chassis-ui.com/react/",
  "scripts": {
    "dev": "astro dev --port 4327 --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:prettier",
    "lint:eslint": "eslint --cache --cache-location ../../.cache/site.eslintcache --report-unused-disable-directives .",
    "lint:stylelint": "stylelint --cache --cache-location ../../.cache/site.stylelintcache \"**/*.{css,scss}\"",
    "lint:prettier": "prettier -c --cache --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "lint:html": "chassis-docs html-validate ../../_site --config html-validate.json",
    "lint:vnu": "chassis-docs vnu ../../_site --filter-file vnu-filters.txt",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "clean": "rimraf ../../_site .astro"
  },
  "dependencies": {
    "@chassis-ui/css": "^0.14.0",
    "@chassis-ui/icons": "^0.3.1",
    "@chassis-ui/react": "workspace:*",
    "@chassis-ui/website-tokens": "^0.1.0",
    "@internationalized/date": "^3.12.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@chassis-ui/docs": "^0.12.0",
    "@pagefind/component-ui": "^1.5.2",
    "@shikijs/transformers": "^4.5.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "autoprefixer": "^10.6.1",
    "html-validate": "^11.17.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.31",
    "postcss-prefix-custom-properties": "^0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-stately": "^3.51.0",
    "rehype-autolink-headings": "^7.1.0",
    "rimraf": "^6.0.1",
    "sass": "^1.106.1",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vnu-jar": "^26.10.12"
  }
}
