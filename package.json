{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "docs:api": "lerna run --scope \"@chassis-ui/react-docs\" api --stream",
    "docs:dev": "lerna run --scope \"@chassis-ui/react-docs\" develop --stream",
    "docs:build": "lerna run --scope \"@chassis-ui/react-docs\" build --stream",
    "docs:clean": "lerna run --scope \"@chassis-ui/react-docs\" clean",
    "lib:build": "lerna run --scope \"@chassis-ui/react\" build --stream",
    "lint": "eslint \"packages/**/src/**/*.{js,ts,tsx}\"",
    "test": "node node_modules/.bin/jest --coverage",
    "test:update": "node node_modules/.bin/jest --coverage --updateSnapshot"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.7.0",
    "eslint": "8.4.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-react-hooks": "^4.3.0",
    "jest": "^29.0.0",
    "jest-canvas-mock": "^2.3.1",
    "jest-environment-jsdom": "^29.0.0",
    "lerna": "^4.0.0",
    "prettier": "^2.5.1",
    "ts-jest": "^29.0.0"
  },
  "dependencies": {
    "@chassis-ui/tokens": "link:../chassis-tokens"
  }
}
