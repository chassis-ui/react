---
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import { replacePlaceholdersInHtml } from '@chassis-ui/docs'

interface Props {
  /**
   * The CSS class(es) to be added to the preview wrapping `div` element.
   */
  class?: string
  /**
   * The source code to display below the live preview.
   * Auto-derived at build time by the `remarkCxExample` remark plugin unless `customMarkup` is set.
   */
  code: string
  /**
   * Overrides the displayed source code (e.g. to abbreviate large data literals) while the
   * actual children still render live in the preview above.
   */
  customMarkup?: string
  /**
   * The preview wrapping `div` element ID.
   */
  id?: string
  /**
   * Language used to highlight the displayed source.
   * @default 'jsx'
   */
  lang?: string
}

const { class: className, id, code, customMarkup, lang = 'jsx' } = Astro.props
const markup = customMarkup ?? code

// const sourceMarkup = replacePlaceholdersInHtml(markup).replace(' client:load', '')
const simplifiedMarkup = markup
  .replace(
    /<svg.*class="cxd-placeholder-image(?:-large)?(?: *?cxd-placeholder-image-large)? ?(.*?)".*?<\/svg>/g,
    (_match, classes) => `<img src="..."${classes ? ` class="${classes}"` : ''} alt="...">`
  )
  .replace(
    /<img.*class="cxd-placeholder-image(?:-large)?(?: *?cxd-placeholder-image-large)? ?(.*?)".*?>/g,
    (_match, classes) => `<img src="..."${classes ? ` class="${classes}"` : ''} alt="...">`
  )
  .replace(/(<svg class="icon\b[^"]*")\s+width="\d+"\s+height="\d+"/g, '$1')
  .replace(/href="\/static\/icons\/chassis-icons\.svg#/g, 'href="#')
---

<div class="cxd-example-snippet cxd-code-snippet" data-pagefind-ignore>
  <div id={id} class:list={['cxd-example m-0 border-0 context', className]}>
    <slot />
  </div>
  {simplifiedMarkup && <Code code={simplifiedMarkup} lang={lang} nestedInExample hasPreview />}
</div>
