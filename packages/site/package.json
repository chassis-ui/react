{
  "name": "chassis-react-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Chassis React documentation site",
  "homepage": "https://chassis-ui.com/react/",
  "scripts": {
    "dev": "astro dev --port 4327 --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm lint:prettier",
    "lint:eslint": "eslint --cache --cache-location ../../.cache/site.eslintcache --report-unused-disable-directives .",
    "lint:stylelint": "stylelint --cache --cache-location ../../.cache/site.stylelintcache \"**/*.{css,scss}\"",
    "lint:prettier": "prettier -c --cache --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "format": "prettier --write --ignore-path ../../.gitignore --ignore-path ../../.prettierignore .",
    "clean": "rimraf ../../_site .astro"
  },
  "dependencies": {
    "@chassis-ui/css": "^0.4.0-0",
    "@chassis-ui/docs": "^0.4.0-0",
    "@chassis-ui/icons": "^0.3.1",
    "@chassis-ui/react": "workspace:*",
    "@chassis-ui/tokens": "^0.4.0",
    "@internationalized/date": "^3.12.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@pagefind/component-ui": "^1.5.2",
    "@shikijs/transformers": "^4.3.1",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^7.2.0",
    "autoprefixer": "^10.5.0",
    "clipboard": "^2.0.11",
    "js-yaml": "^5.4.1",
    "mdast-util-mdx-jsx": "^3.2.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.0",
    "postcss-prefix-custom-properties": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-stately": "^3.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rimraf": "^6.0.1",
    "sass": "^1.101.0",
    "shiki": "^4.3.1",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  }
}
