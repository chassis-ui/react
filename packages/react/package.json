{
  "name": "@chassis-ui/react",
  "version": "0.1.0",
  "description": "Chassis UI Components Library for React.js",
  "keywords": [
    "react",
    "react-component",
    "react component",
    "chassis-ui",
    "chassis react",
    "ui library",
    "ui components",
    "component library",
    "components"
  ],
  "homepage": "https://chassis-ui.com/react/",
  "bugs": {
    "url": "https://github.com/chassis-ui/react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chassis-ui/react.git"
  },
  "license": "MIT",
  "author": "Chassis UI Team",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "jsnext:main": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch"
  },
  "devDependencies": {
    "@popperjs/core": "^2.11.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-transition-group": "^4.4.11",
    "classnames": "^2.3.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-popper": "^2.2.5",
    "react-transition-group": "^4.4.2",
    "rollup": "^4.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
