---
import type { MarkdownHeading } from 'astro'
import Sidebar from '../components/Sidebar.astro'
import Toc from '../components/Toc.astro'

interface Props {
  frontmatter: {
    title?: string
    description?: string
    toc?: boolean
  }
  headings?: MarkdownHeading[]
  id?: string
}

const { frontmatter, headings = [], id = '' } = Astro.props
const showToc = frontmatter.toc !== false && headings.filter((h) => h.depth === 2).length > 1
const base = import.meta.env.BASE_URL  // '/react/'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title ? `${frontmatter.title} · Chassis React` : 'Chassis React'}</title>
    {frontmatter.description && <meta name="description" content={frontmatter.description} />}
    <link rel="stylesheet" href={`${base}static/js/chassis.bundle.min.js`.replace('.js', '.css')} />
  </head>
  <body>
    <header class="cxd-topbar">
      <div class="cxd-topbar-inner">
        <a class="cxd-topbar-brand" href={base}>
          <strong>Chassis React</strong>
        </a>
        <nav class="cxd-topbar-nav" aria-label="Top navigation">
          <a href="https://chassis-ui.com" class="cxd-topbar-link">chassis-ui.com</a>
          <a href="https://github.com/chassis-ui/react" class="cxd-topbar-link">GitHub</a>
        </nav>
      </div>
    </header>

    <div class="cxd-docs-layout">
      <aside class="cxd-docs-sidebar">
        <Sidebar currentSlug={id} />
      </aside>

      <main class="cxd-docs-main" id="main-content">
        <div class="cxd-docs-content">
          {frontmatter.title && <h1 class="cxd-docs-title">{frontmatter.title}</h1>}
          {frontmatter.description && <p class="cxd-docs-description lead">{frontmatter.description}</p>}
          <slot />
        </div>
      </main>

      {showToc && (
        <aside class="cxd-docs-toc">
          <Toc headings={headings} />
        </aside>
      )}
    </div>

    <slot name="scripts" />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: #212529;
    background: #fff;
  }

  /* Top bar */
  .cxd-topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid #dee2e6;
    height: 3.5rem;
  }

  .cxd-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
  }

  .cxd-topbar-brand {
    text-decoration: none;
    color: inherit;
    font-size: 1.125rem;
  }

  .cxd-topbar-nav {
    display: flex;
    gap: 1.5rem;
  }

  .cxd-topbar-link {
    color: #6c757d;
    text-decoration: none;
    font-size: 0.875rem;
  }

  .cxd-topbar-link:hover { color: #212529; }

  /* Docs three-column layout */
  .cxd-docs-layout {
    display: grid;
    grid-template-columns: 16rem 1fr;
    grid-template-areas: "sidebar main";
    max-width: 1400px;
    margin: 0 auto;
    min-height: calc(100vh - 3.5rem);
  }

  @media (min-width: 1280px) {
    .cxd-docs-layout {
      grid-template-columns: 16rem 1fr 14rem;
      grid-template-areas: "sidebar main toc";
    }
  }

  .cxd-docs-sidebar {
    grid-area: sidebar;
    border-right: 1px solid #dee2e6;
    overflow-y: auto;
    position: sticky;
    top: 3.5rem;
    height: calc(100vh - 3.5rem);
  }

  .cxd-docs-main {
    grid-area: main;
    min-width: 0;
  }

  .cxd-docs-content {
    max-width: 52rem;
    padding: 2rem 2.5rem;
  }

  .cxd-docs-toc {
    grid-area: toc;
    padding: 0 1rem;
    border-left: 1px solid #dee2e6;
    position: sticky;
    top: 3.5rem;
    height: calc(100vh - 3.5rem);
    overflow-y: auto;
  }

  .cxd-docs-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .cxd-docs-description {
    color: #6c757d;
    font-size: 1.0625rem;
    margin-bottom: 2rem;
  }

  /* Example wrapper */
  .cxd-example {
    padding: 1.5rem;
    border: 1px solid #dee2e6;
    border-radius: 0.375rem;
    margin-bottom: 0;
  }

  .cxd-example + pre {
    border-top: none;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    margin-top: 0;
  }

  /* Prop table */
  .cxd-prop-table-wrapper {
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .cxd-prop-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .cxd-prop-table th,
  .cxd-prop-table td {
    padding: 0.5rem 0.75rem;
    border: 1px solid #dee2e6;
    vertical-align: top;
  }

  .cxd-prop-table th {
    background: #f8f9fa;
    font-weight: 600;
    white-space: nowrap;
  }

  .cxd-prop-table code {
    font-size: 0.8125rem;
    background: #f1f3f5;
    padding: 0.1em 0.3em;
    border-radius: 0.2em;
  }

  /* Code blocks */
  pre[class*="language-"] {
    border-radius: 0.375rem;
    margin: 0 0 1.5rem;
    font-size: 0.875rem;
    overflow-x: auto;
  }

  /* Headings */
  h2 { font-size: 1.375rem; margin-top: 2.5rem; margin-bottom: 0.75rem; }
  h3 { font-size: 1.125rem; margin-top: 2rem; margin-bottom: 0.5rem; }
  h4 { font-size: 1rem; margin-top: 1.5rem; }

  p { margin: 0 0 1rem; }
  code { font-size: 0.875em; }
</style>
