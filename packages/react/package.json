{
  "name": "@chassis-ui/react",
  "version": "0.1.0",
  "description": "Chassis UI Components Library for React.js",
  "keywords": [
    "react",
    "react-component",
    "react component",
    "chassis-ui",
    "chassis react",
    "ui library",
    "ui components",
    "component library",
    "components"
  ],
  "homepage": "https://chassis-ui.com/react/",
  "bugs": {
    "url": "https://github.com/chassis-ui/react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chassis-ui/react.git"
  },
  "license": "MIT",
  "author": "Chassis UI Team",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "jsnext:main": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "rollup -c && rm -rf dist/src dist/test",
    "dev": "rollup -c --watch",
    "generate": "plop --plopfile plopfile.mjs component",
    "generate:sub": "plop --plopfile plopfile.mjs sub",
    "test": "vitest run --coverage",
    "test:update": "vitest run --coverage -u",
    "check:bundle": "bundlewatch --config .bundlewatch.config.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:visual": "pnpm build-storybook --quiet && playwright test",
    "test:visual:update": "pnpm build-storybook --quiet && playwright test --update-snapshots"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "classnames": "^2.3.1",
    "react-aria": "^3.0.0",
    "react-stately": "^3.0.0",
    "react-transition-group": "^4.4.2"
  },
  "devDependencies": {
    "@chassis-ui/css": "^0.3.5",
    "@chassis-ui/tokens": "^0.3.0",
    "@playwright/test": "1.62.1",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-transition-group": "^4.4.11",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-istanbul": "^4.1.10",
    "bundlewatch": "^0.4.2",
    "http-server": "^14.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.0",
    "plop": "^4.0.5",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.101.0",
    "storybook": "^10.5.6",
    "tslib": "^2.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
