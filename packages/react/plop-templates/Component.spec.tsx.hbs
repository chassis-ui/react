import * as React from 'react'
import { render, screen } from '@testing-library/react'
import { axe } from 'jest-axe'

import { {{pascalCase name}} } from '../../../index'

describe('{{pascalCase name}}', () => {
  describe('rendering', () => {
    test('renders with the base class by default', () => {
      render(<{{pascalCase name}}>Test</{{pascalCase name}}>)
      const el = screen.getByText('Test')
      expect(el).toHaveClass('{{kebabCase name}}')
      expect(el.tagName).toBe('DIV')
    })

    test('matches the baseline markup snapshot', () => {
      const { container } = render(<{{pascalCase name}}>Test</{{pascalCase name}}>)
      expect(container).toMatchSnapshot()
    })

    test('renders as a custom component', () => {
      render(
        <{{pascalCase name}} className="bazinga" component="span">
          Test
        </{{pascalCase name}}>
      )
      const el = screen.getByText('Test')
      expect(el).toHaveClass('{{kebabCase name}}', 'bazinga')
      expect(el.tagName).toBe('SPAN')
    })
  })

  describe('accessibility', () => {
    test('has no axe violations', async () => {
      const { container } = render(<{{pascalCase name}}>Test</{{pascalCase name}}>)
      expect(await axe(container)).toHaveNoViolations()
    })
  })
})
