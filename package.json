{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm site:build",
    "clean": "pnpm react:clean && pnpm site:clean",
    "setup": "pnpm sync-submodules && pnpm react:build",
    "start": "pnpm setup && pnpm dev",
    "dev": "pnpm react:dev & pnpm site:dev",
    "preview": "pnpm site:preview",
    "lint": "pnpm react:lint && pnpm site:lint && pnpm lint:html && pnpm lint:vnu",
    "lint:eslint": "eslint \"packages/**/src/**/*.{js,ts,tsx}\"",
    "lint:html": "node build/html-validate.js",
    "lint:vnu": "node build/vnu-jar.js",
    "react:build": "pnpm --filter @chassis-ui/react build",
    "react:dev": "pnpm --filter @chassis-ui/react dev",
    "react:generate": "ts-node --project build/tsconfig.json build/generate-api.ts",
    "react:lint": "pnpm --filter @chassis-ui/react lint",
    "react:check:api": "pnpm --filter @chassis-ui/react check:api",
    "react:check:api:update": "pnpm --filter @chassis-ui/react check:api:update",
    "react:check:bundle": "pnpm --filter @chassis-ui/react check:bundle",
    "react:check:package": "pnpm --filter @chassis-ui/react check:package",
    "react:clean": "rm -rf packages/react/dist packages/react/coverage",
    "site": "pnpm site:build && pnpm site:lint && pnpm lint:html && pnpm lint:vnu",
    "site:setup": "pnpm sync-submodules && pnpm react:build && pnpm react:generate",
    "site:build": "pnpm --filter chassis-react-site build && pnpm site:pagefind",
    "site:check": "pnpm --filter chassis-react-site check",
    "site:clean": "rm -rf _site packages/site/node_modules packages/site/.astro packages/site/public",
    "site:dev": "pnpm --filter chassis-react-site dev",
    "site:lint": "pnpm --filter chassis-react-site lint",
    "site:pagefind": "pagefind --site _site --output-subdir react/pagefind",
    "site:preview": "pnpm --filter chassis-react-site preview",
    "storybook": "pnpm --filter @chassis-ui/react storybook",
    "storybook:build": "pnpm --filter @chassis-ui/react storybook:build",
    "test": "pnpm --filter @chassis-ui/react test",
    "test:update": "pnpm --filter @chassis-ui/react test:update",
    "test:visual": "pnpm --filter @chassis-ui/react test:visual",
    "test:visual:update": "pnpm --filter @chassis-ui/react test:visual:update",
    "test:visual:update:linux": "pnpm --filter @chassis-ui/react test:visual:update:linux",
    "smoke:build": "pnpm react:build && pnpm --filter './smoke-tests/*' build",
    "changeset": "changeset",
    "changeset:version": "changeset version && node build/sync-version-refs.js",
    "changeset:publish": "pnpm react:build && changeset publish",
    "sync-submodules": "node build/sync-submodules.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^70.0.0",
    "globals": "^17.11.0",
    "html-validate": "^11.10.0",
    "pagefind": "^1.5.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "react-docgen-typescript": "^2.4.0",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vnu-jar": "^26.8.21"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
