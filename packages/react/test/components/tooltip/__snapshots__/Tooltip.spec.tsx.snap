exports[`Tooltip > rendering > renders placement, arrow and content once shown on hover 1`] = `
<body>
  <div>
    <a
      aria-describedby="react-aria-:r1:"
      class="link"
    >
      Test
    </a>
  </div>
  <div
    class="tooltip cx-tooltip-auto fade show"
    data-cx-placement="right"
    id="react-aria-:r1:"
    role="tooltip"
    style="position: absolute; max-height: 0px; top: 12px; left: 6px;"
  >
    <div
      aria-hidden="true"
      class="tooltip-arrow"
      role="presentation"
      style="position: absolute; transform: translateY(-50%); top: -4px;"
    />
    <div
      class="tooltip-inner"
    >
      content
    </div>
  </div>
</body>
`;
