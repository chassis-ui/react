---
import { getConfig, getDocsPath } from '@chassis-ui/docs/site'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import Icon from '@chassis-ui/docs/shortcodes/Icon.astro'
---

<div class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content py-3xl md:py-6xl">
    <div class="grid mb-3xl md:mb-6xl">
      <header class="section-header col-span-full xl:col-span-10 xl:col-start-2 text-center">
        <p class="module-title fg-primary md:font-xl font-mass text-uppercase mb-xs md:mb-sm">
          CHASSIS REACT
        </p>
        <h1 class="font-hero mb-sm md:mb-md lg:mb-lg">
          <span class="font-normal">Accessible React Components</span>
          <span class="d-block">for the Chassis Design System</span>
        </h1>
        <p class="font-lead mb-md md:mb-lg">
          A TypeScript component library that renders Chassis CSS markup. Built on React Aria for
          accessibility, polymorphic by design, tree-shakeable down to a single component, and ready
          for Server Components.
        </p>
      </header>
    </div>

    <div class="section-features d-flex flex-column gap-md mb-md md:mb-lg lg:w-6/12 mx-auto">
      <!-- Code snippet -->
      <Code
        noToolbar
        containerClass="md:mx-auto md:mw-100"
        lang="bash"
        code="npm install @chassis-ui/react @chassis-ui/css"
      />
      <!-- Buttons -->
      <div class="d-grid md:d-flex gap-md md:justify-content-center flex-wrap">
        <a href={getDocsPath('')} class="button primary lg">
          <Icon name="book-open-outline" />
          <span>Get Started</span>
        </a>
        <a href={getConfig().repo} class="button default lg" target="_blank" rel="noopener">
          <Icon name="github-brand" />
          <span>View on GitHub</span>
        </a>
      </div>

      <!-- Version info -->
      <p class="fg-subtle mb-0 text-center font-md">
        Currently <strong>v{getConfig().currentVersion}</strong>
        <span class="px-2xs">&middot;</span>
        <a
          href={getConfig().repo + '/blob/main/packages/react/CHANGELOG.md'}
          class="link-secondary text-nowrap"
        >
          Changes
        </a>
      </p>
    </div>
  </div>
</div>
