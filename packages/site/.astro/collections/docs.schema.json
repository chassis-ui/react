{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "added": {
      "type": "object",
      "properties": {
        "show_badge": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ]
    },
    "aliases": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "description": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "const": "rtl"
    },
    "extra_js": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "async": {
            "type": "boolean"
          },
          "src": {
            "type": "string"
          }
        },
        "required": [
          "src"
        ]
      }
    },
    "mdn": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "title"
        ]
      }
    },
    "thumbnail": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "toc": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  }
}