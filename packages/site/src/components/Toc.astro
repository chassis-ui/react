---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const h2s = headings.filter((h) => h.depth === 2)
---

{h2s.length > 1 && (
  <nav class="cxd-toc" aria-label="On this page">
    <div class="cxd-toc-heading">On this page</div>
    <ul class="cxd-toc-list">
      {h2s.map((heading) => (
        <li>
          <a href={`#${heading.slug}`} class="cxd-toc-link">{heading.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .cxd-toc {
    position: sticky;
    top: 1.5rem;
    padding: 1rem 0;
    font-size: 0.8125rem;
  }

  .cxd-toc-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cxd-secondary-color, #6c757d);
    margin-bottom: 0.5rem;
  }

  .cxd-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cxd-toc-list li {
    margin: 0;
  }

  .cxd-toc-link {
    display: block;
    padding: 0.2rem 0;
    color: var(--cxd-secondary-color, #6c757d);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .cxd-toc-link:hover {
    color: var(--cxd-body-color, #212529);
  }
</style>
